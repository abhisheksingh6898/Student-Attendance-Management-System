-- STEP 11: DISPLAY ATTENDANCE PERCENTAGE

SELECT
    STUDENT_ID,
    STUDENT_NAME,
    GET_ATTENDANCE_PERCENTAGE(STUDENT_ID)
        AS ATTENDANCE_PERCENTAGE
FROM STUDENTS
ORDER BY STUDENT_ID;

-- STEP 12: CURSOR REPORT FOR STUDENTS
-- WHOSE ATTENDANCE IS BELOW 75%

DECLARE
    CURSOR LOW_ATTENDANCE_CURSOR IS
        SELECT
            STUDENT_ID,
            STUDENT_NAME,
            GET_ATTENDANCE_PERCENTAGE(STUDENT_ID) AS PERCENTAGE
        FROM STUDENTS
        WHERE GET_ATTENDANCE_PERCENTAGE(STUDENT_ID) < 75
        ORDER BY STUDENT_ID;

    V_STUDENT_ID NUMBER;
    V_STUDENT_NAME VARCHAR2(100);
    V_PERCENTAGE NUMBER;
BEGIN
    OPEN LOW_ATTENDANCE_CURSOR;

    LOOP
        FETCH LOW_ATTENDANCE_CURSOR
        INTO V_STUDENT_ID, V_STUDENT_NAME, V_PERCENTAGE;

        EXIT WHEN LOW_ATTENDANCE_CURSOR%NOTFOUND;

        DBMS_OUTPUT.PUT_LINE(
            'ID: ' || V_STUDENT_ID ||
            ' | Name: ' || V_STUDENT_NAME ||
            ' | Attendance: ' || V_PERCENTAGE || '%'
        );
    END LOOP;

    CLOSE LOW_ATTENDANCE_CURSOR;
END;
/

-- STEP 13: FINAL ATTENDANCE SUMMARY REPORT

SELECT
    S.STUDENT_ID,
    S.STUDENT_NAME,
    S.COURSE,
    COUNT(A.ATTENDANCE_ID) AS TOTAL_CLASSES,
    SUM(
        CASE
            WHEN A.STATUS = 'Present' THEN 1
            ELSE 0
        END
    ) AS PRESENT_COUNT,
    SUM(
        CASE
            WHEN A.STATUS = 'Absent' THEN 1
            ELSE 0
        END
    ) AS ABSENT_COUNT,
    GET_ATTENDANCE_PERCENTAGE(S.STUDENT_ID)
        AS ATTENDANCE_PERCENTAGE
FROM STUDENTS S
LEFT JOIN ATTENDANCE A
    ON S.STUDENT_ID = A.STUDENT_ID
GROUP BY
    S.STUDENT_ID,
    S.STUDENT_NAME,
    S.COURSE
ORDER BY S.STUDENT_ID;

-- STEP 14: STUDENTS BELOW 75% ATTENDANCE

SELECT
    STUDENT_ID,
    STUDENT_NAME,
    COURSE,
    GET_ATTENDANCE_PERCENTAGE(STUDENT_ID)
        AS ATTENDANCE_PERCENTAGE
FROM STUDENTS
WHERE GET_ATTENDANCE_PERCENTAGE(STUDENT_ID) < 75
ORDER BY STUDENT_ID;
