-- STEP 5: CREATE ATTENDANCE VALIDATION TRIGGER

CREATE OR REPLACE TRIGGER TRG_ATTENDANCE_VALIDATE
BEFORE INSERT OR UPDATE ON ATTENDANCE
FOR EACH ROW
BEGIN
    IF :NEW.STATUS IS NULL
       OR UPPER(TRIM(:NEW.STATUS)) NOT IN ('PRESENT', 'ABSENT')
    THEN
        RAISE_APPLICATION_ERROR(
            -20010,
            'Invalid status! Enter Present or Absent.'
        );
    END IF;

    :NEW.STATUS := INITCAP(TRIM(UPPER(:NEW.STATUS)));

    :NEW.ATTENDANCE_DATE :=
        TRUNC(NVL(:NEW.ATTENDANCE_DATE, SYSDATE));
END;
/

-- STEP 6: CREATE PROCEDURE TO MARK ATTENDANCE

CREATE OR REPLACE PROCEDURE MARK_ATTENDANCE (
    P_STUDENT_ID IN NUMBER,
    P_STATUS IN VARCHAR2
)
AS
    V_STUDENT_ID NUMBER;
    V_COUNT NUMBER;
    V_STATUS VARCHAR2(10);
BEGIN
    V_STATUS := UPPER(TRIM(P_STATUS));

    IF V_STATUS IS NULL
       OR V_STATUS NOT IN ('PRESENT', 'ABSENT')
    THEN
        RAISE_APPLICATION_ERROR(
            -20002,
            'Enter Present or Absent.'
        );
    END IF;

    SELECT STUDENT_ID
    INTO V_STUDENT_ID
    FROM STUDENTS
    WHERE STUDENT_ID = P_STUDENT_ID;

    SELECT COUNT(*)
    INTO V_COUNT
    FROM ATTENDANCE
    WHERE STUDENT_ID = P_STUDENT_ID
      AND ATTENDANCE_DATE >= TRUNC(SYSDATE)
      AND ATTENDANCE_DATE < TRUNC(SYSDATE) + 1;

    IF V_COUNT > 0 THEN
        RAISE_APPLICATION_ERROR(
            -20003,
            'Attendance already marked for today!'
        );
    END IF;

    INSERT INTO ATTENDANCE (
        ATTENDANCE_ID,
        STUDENT_ID,
        ATTENDANCE_DATE,
        STATUS
    )
    VALUES (
        ATTENDANCE_SEQ.NEXTVAL,
        P_STUDENT_ID,
        TRUNC(SYSDATE),
        INITCAP(V_STATUS)
    );

    DBMS_OUTPUT.PUT_LINE(
        'Attendance marked successfully!'
    );

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(
            -20001,
            'Student ID does not exist!'
        );
END;
/

-- STEP 7: CREATE ATTENDANCE PERCENTAGE FUNCTION

CREATE OR REPLACE FUNCTION GET_ATTENDANCE_PERCENTAGE (
    P_STUDENT_ID IN NUMBER
)
RETURN NUMBER
AS
    V_TOTAL_CLASSES NUMBER;
    V_PRESENT_CLASSES NUMBER;
BEGIN
    SELECT COUNT(*)
    INTO V_TOTAL_CLASSES
    FROM ATTENDANCE
    WHERE STUDENT_ID = P_STUDENT_ID;

    SELECT COUNT(*)
    INTO V_PRESENT_CLASSES
    FROM ATTENDANCE
    WHERE STUDENT_ID = P_STUDENT_ID
      AND STATUS = 'Present';

    IF V_TOTAL_CLASSES = 0 THEN
        RETURN 0;
    END IF;

    RETURN ROUND(
        (V_PRESENT_CLASSES / V_TOTAL_CLASSES) * 100,
        2
    );
END;
/

